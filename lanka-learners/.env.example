# Copy to .env and fill in. NEVER commit .env.

# ---------------------------------------------------------------------------
# Database — PostgreSQL. Neon is the recommended production provider.
# Neon: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/lanka_learners?schema=public"

# ---------------------------------------------------------------------------
# Auth — signing key for session JWTs. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET="dd"

# ---------------------------------------------------------------------------
# Initial OWNER account, created by `npm run db:seed`.
# Use a strong password and change it after the first sign-in.
# The seed hashes this value — it is never stored in plain text.
# ---------------------------------------------------------------------------
INITIAL_OWNER_USERNAME="owner"
INITIAL_OWNER_PASSWORD=""
INITIAL_OWNER_NAME="System Owner"
INITIAL_OWNER_EMAIL="owner@example.com"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Lanka Learners"

# ---------------------------------------------------------------------------
# Profile photo storage — configure ONE of these.
# Vercel Blob is used when BLOB_READ_WRITE_TOKEN is set; otherwise Cloudinary.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
